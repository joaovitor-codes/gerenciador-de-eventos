{
  "info": {
    "name": "Gerenciador de Eventos",
    "description": "API REST de gerenciamento de eventos e inscrições.\n\nFluxo sugerido: Registrar (ou Login) → Cadastrar evento → Inscrever-se → Minhas inscrições → Cancelar inscrição.\n\nO token, o id do evento e o id da inscrição são salvos automaticamente nas variáveis da collection.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000/api"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "evento_id",
      "value": "1"
    },
    {
      "key": "inscricao_id",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "Autenticação",
      "item": [
        {
          "name": "Registrar",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/register",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "register"
              ]
            },
            "description": "Cria um usuário e retorna o token de acesso.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Maria Silva\",\n  \"email\": \"maria@example.com\",\n  \"password\": \"senha123\",\n  \"password_confirmation\": \"senha123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200 || pm.response.code === 201) {",
                  "    pm.collectionVariables.set('token', pm.response.json().token);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "login"
              ]
            },
            "description": "Autentica o usuário e retorna o token de acesso.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"maria@example.com\",\n  \"password\": \"senha123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200 || pm.response.code === 201) {",
                  "    pm.collectionVariables.set('token', pm.response.json().token);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Usuário logado",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/me",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "me"
              ]
            },
            "description": "Retorna os dados do usuário autenticado."
          },
          "response": []
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/logout",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "logout"
              ]
            },
            "description": "Revoga o token atual."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    pm.collectionVariables.set('token', '');",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Eventos",
      "item": [
        {
          "name": "Listar eventos",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/eventos?por_pagina=15",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "eventos"
              ],
              "query": [
                {
                  "key": "por_pagina",
                  "value": "15",
                  "description": "Itens por página"
                }
              ]
            },
            "description": "Lista paginada de eventos, com vagas restantes. Rota pública.",
            "auth": {
              "type": "noauth"
            }
          },
          "response": []
        },
        {
          "name": "Consultar evento",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/eventos/{{evento_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "eventos",
                "{{evento_id}}"
              ]
            },
            "description": "Retorna um evento específico. Rota pública.",
            "auth": {
              "type": "noauth"
            }
          },
          "response": []
        },
        {
          "name": "Cadastrar evento",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/eventos",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "eventos"
              ]
            },
            "description": "Cadastra um evento. Requer autenticação.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Semana de Tecnologia\",\n  \"descricao\": \"Palestras e oficinas sobre desenvolvimento web.\",\n  \"local\": \"Auditório A\",\n  \"dt_evento\": \"2027-03-15\",\n  \"horario\": \"19:30\",\n  \"qtd_max_participantes\": 50\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    pm.collectionVariables.set('evento_id', pm.response.json().data.id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Atualizar evento",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/eventos/{{evento_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "eventos",
                "{{evento_id}}"
              ]
            },
            "description": "Atualiza os campos enviados. Requer autenticação.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Semana de Tecnologia 2027\",\n  \"qtd_max_participantes\": 80\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "Excluir evento",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/eventos/{{evento_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "eventos",
                "{{evento_id}}"
              ]
            },
            "description": "Exclui o evento. Requer autenticação."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Inscrições",
      "item": [
        {
          "name": "Inscrever-se em evento",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/eventos/{{evento_id}}/inscricoes",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "eventos",
                "{{evento_id}}",
                "inscricoes"
              ]
            },
            "description": "Inscreve o usuário logado no evento. Retorna 422 se o evento estiver lotado ou se o usuário já estiver inscrito."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    pm.collectionVariables.set('inscricao_id', pm.response.json().data.id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Minhas inscrições",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/minhas-inscricoes",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "minhas-inscricoes"
              ]
            },
            "description": "Lista as inscrições do usuário logado, com os dados do evento."
          },
          "response": []
        },
        {
          "name": "Cancelar inscrição",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/inscricoes/{{inscricao_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "inscricoes",
                "{{inscricao_id}}"
              ]
            },
            "description": "Cancela uma inscrição do usuário logado. Retorna 403 se a inscrição for de outro usuário."
          },
          "response": []
        }
      ]
    }
  ]
}